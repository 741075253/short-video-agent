      "baseUrlEnv": "QIAN_WEN_BASE_URL",
      "baseUrl": "https://dashscope.aliyuncs.com",
      "model": "happyhorse-1.1-t2v",
      "inputMode": "t2v",
      "capabilities": {
        "duration": { "min": 3, "max": 15, "default": 5 },
